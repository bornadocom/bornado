{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bornado.local/schemas/event-envelope.v1.schema.json",
  "title": "EventEnvelopeV1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "sourceSystem",
    "idempotencyKey",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string" },
    "eventType": { "type": "string" },
    "eventVersion": { "type": "integer" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "sourceSystem": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "locale": { "type": "string" },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
