{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bornado.local/schemas/listing.rejected.v1.schema.json",
  "title": "ListingRejectedV1",
  "allOf": [
    { "$ref": "./event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "listing.rejected" },
        "payload": {
          "type": "object",
          "required": ["listing"],
          "properties": {
            "listing": {
              "type": "object",
              "required": ["id", "title", "editUrl"],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "editUrl": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
