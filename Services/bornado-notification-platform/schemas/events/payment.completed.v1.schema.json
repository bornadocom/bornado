{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bornado.local/schemas/payment.completed.v1.schema.json",
  "title": "PaymentCompletedV1",
  "allOf": [
    { "$ref": "./event-envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "payment.completed" },
        "payload": {
          "type": "object",
          "required": ["payment"],
          "properties": {
            "payment": {
              "type": "object",
              "required": ["orderId"],
              "properties": {
                "orderId": { "type": "string" }
              }
            }
          }
        }
      }
    }
  ]
}
