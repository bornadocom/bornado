<wpml-config>
    <custom-fields>
        <!-- Core Ad Data - Set to COPY to ensure sync across languages -->
        <!-- If you update the price/location in the original ad, it will update in the translation -->
        <custom-field action="copy">_adforest_ad_price</custom-field>
        <custom-field action="copy">_adforest_ad_currency</custom-field>
        <custom-field action="copy">_adforest_ad_location</custom-field>
