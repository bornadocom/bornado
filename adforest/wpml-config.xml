        <custom-field action="copy">_adforest_is_feature</custom-field>
        <custom-field action="copy">_adforest_is_feature_date</custom-field>
        <custom-field action="copy">_adforest_ad_status_</custom-field>
        <custom-field action="copy">_adforest_ad_views</custom-field>
        <custom-field action="copy">_adforest_ad_type</custom-field>
        <custom-field action="copy">_adforest_ad_condition</custom-field>
        <custom-field action="copy">_adforest_ad_warranty</custom-field>
